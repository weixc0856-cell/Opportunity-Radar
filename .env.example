OR_FRESHRSS_BASE_URL=http://127.0.0.1:8088
OR_FRESHRSS_USERNAME=replace_me
OR_FRESHRSS_API_KEY=replace_me
# Two known setups:
#   local llama-server      : OR_LLM_API_STYLE=openai    base http://127.0.0.1:8080/v1
#   cc-switch proxy (Claude) : OR_LLM_API_STYLE=anthropic base http://127.0.0.1:15721/v1
# OR_LLM_API_STYLE=openai posts to {base}/chat/completions, anthropic to {base}/messages.
# When the URL is not 127.0.0.1:8080, run-digest.ps1 does not start llama-server.
OR_LLM_API_STYLE=openai
OR_LLM_BASE_URL=http://127.0.0.1:8080/v1
OR_LLM_MODEL=replace_with_model_id
# Production analysis prompt. Rollback: prompts/analyst_v7.md (then prompts/analyst.md for v6).
OR_PROMPT_PATH=prompts/analyst_v9.md
OR_LLM_API_KEY=replace_with_local_api_key
OR_LLM_TIMEOUT_SECONDS=600
# The production prompt spends ~1400-1800 reasoning tokens on reasoning models before it emits
# JSON. Too small a budget returns an empty answer, which looks like a model outage.
OR_LLM_MAX_TOKENS=1200
OR_SMTP_HOST=smtp.163.com
OR_SMTP_PORT=465
OR_SMTP_USERNAME=replace_me
OR_SMTP_PASSWORD=replace_me
OR_EMAIL_FROM=sender@example.com
OR_EMAIL_TO=recipient@example.com,second-recipient@example.com
OR_SMTP_STARTTLS=false
# ssl (implicit TLS, e.g. 163 on 465), starttls, or none. OR_SMTP_TLS is accepted as a legacy alias.
OR_SMTP_SECURITY=ssl
OR_EMAIL_ON_EMPTY=false
OR_ALERT_AFTER_FAILURES=3
OR_MAX_ARTICLES=10
OR_REQUEST_TIMEOUT_SECONDS=20
OR_DB_PATH=data/opportunity_radar.sqlite3
# Machine-specific registry with feed ids and review dates (gitignored). The committed
# template config/sources.csv keeps every source disabled.
OR_SOURCES_PATH=config/sources.local.csv
OR_LOG_PATH=reports/opportunity-radar.log
OR_REPORT_DIR=reports
# Optional deterministic sampling window for comparable shadow runs (UTC).
# since is inclusive, until is exclusive; date-only means 00:00 UTC.
OR_SAMPLE_SINCE=
OR_SAMPLE_UNTIL=
# Start deploy/windows/start-model.ps1 automatically when /health is down (Windows only).
OR_MODEL_AUTOSTART=0
OR_MODEL_START_TIMEOUT=600

# R0 publication gate. Retries are counted AFTER the first attempt:
# 3 connect retries = at most 4 HTTP attempts for one model call; timeouts get 1 retry.
OR_LLM_CONNECT_RETRIES=3
OR_LLM_TIMEOUT_RETRIES=1
OR_LLM_RETRY_BACKOFF=2,5,10
# Retry-After above this many seconds is capped; total backoff per call is capped too.
OR_LLM_RETRY_AFTER_MAX=30
OR_LLM_RETRY_MAX_SECONDS=120
# coverage = analysed / queued. PASS >= 0.8, PASS_WITH_LIMITATIONS in [0.5,0.8), HOLD below 0.5.
OR_PUBLISH_MIN_COVERAGE=0.8
OR_PUBLISH_HOLD_BELOW=0.5
# Unified post-analysis pipeline (R1 backfill, N0-N5 claims, verify, opportunities,
# economic refresh, quality snapshot). Set 0 only for isolated tests.
OR_PIPELINE_ENABLED=1
# Maximum new articles per run sent through N0-N5 (two local-model calls each).
OR_CLAIM_PIPELINE_MAX_ARTICLES=8

# Independent source channels. Each keeps its own database and never writes the RSS
# business tables. deploy/windows/run-sources.ps1 runs them before the daily CLI so the
# economic engine (R5) reads today's observations. A source without its config is
# recorded as not_configured in reports/sources/latest.json, never as success.
OR_INGEST_DB_PATH=data/ingest/opportunity_radar_ingest.sqlite3
# SEC requires a declared contact in the User-Agent, e.g. "OpportunityRadar you@example.com".
OR_INGEST_SEC_USER_AGENT=
# EIA API v2 key (https://www.eia.gov/opendata/).
OR_INGEST_EIA_API_KEY=
OR_PILOT_DB_PATH=data/pilot/source_pilot.sqlite3
OR_PILOT_USER_AGENT=OpportunityRadar-Pilot/0.1 (local research)

# Optional source expansion (disabled by default)
OR_YOUTUBE_ENABLED=0
OR_DISCOVERY_ENABLED=0

# Optional source expansion
# OR_YTDLP=E:/YouTube-B/.venv/Scripts/yt-dlp.exe
# OR_YOUTUBE_CONFIG=config/youtube_sources.json
# OR_DISCOVERY_CONFIG=config/discovery_sources.json
# OR_NEWSAPI_KEY=
# OR_BRAVE_API_KEY=
# OR_GUARDIAN_API_KEY=
